{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadenceflow.local/schema/project-v2.json",
  "title": "CadenceFlow Project v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "createdAt",
    "updatedAt",
    "activeModule",
    "tonic",
    "globalTiming",
    "groove",
    "melodyTrack",
    "defaults",
    "moduleTemplateStates",
    "progression",
    "customPresets"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "activeModule": { "enum": ["progressions", "dark-harmony"] },
    "tonic": { "$ref": "#/$defs/pitchClass" },
    "globalTiming": { "$ref": "#/$defs/globalTiming" },
    "groove": { "$ref": "#/$defs/groove" },
    "melodyTrack": { "$ref": "#/$defs/melodyTrack" },
    "presentation": { "type": "object" },
    "defaults": { "type": "object" },
    "moduleTemplateStates": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "progression": { "$ref": "#/$defs/progression" },
    "temporaryBranch": {
      "anyOf": [{ "$ref": "#/$defs/temporaryBranch" }, { "type": "null" }]
    },
    "customPresets": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "pitchClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semitone"],
      "properties": {
        "semitone": { "type": "integer", "minimum": 0, "maximum": 11 }
      }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer" },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beats"],
      "properties": {
        "beats": { "$ref": "#/$defs/rational" },
        "displayHint": { "type": "string" }
      }
    },
    "globalTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tempoBpm", "meter"],
      "properties": {
        "tempoBpm": { "type": "number", "exclusiveMinimum": 0 },
        "meter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator", "grouping"],
          "properties": {
            "numerator": { "type": "integer", "minimum": 1 },
            "denominator": { "enum": [1, 2, 4, 8, 16, 32] },
            "grouping": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "groove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feel", "swingAmount"],
      "properties": {
        "feel": { "enum": ["straight", "swing"] },
        "swingAmount": { "type": "number" }
      }
    },
    "melodyTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument", "muted", "solo", "volume"],
      "properties": {
        "instrument": {
          "enum": ["flute", "violin", "clarinet", "oboe", "cello", "synth-lead"]
        },
        "muted": { "type": "boolean" },
        "solo": { "type": "boolean" },
        "volume": { "type": "integer", "minimum": 0, "maximum": 127 }
      },
      "not": {
        "required": ["muted", "solo"],
        "properties": {
          "muted": { "const": true },
          "solo": { "const": true }
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        },
        "selectedStepId": { "type": ["string", "null"] },
        "loopRegion": { "type": ["object", "null"] }
      }
    },
    "temporaryBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originAtEnd", "steps", "compositionIntent"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "originStepId": { "type": "string", "minLength": 1 },
        "originAtEnd": { "type": "boolean" },
        "rejoinStepId": { "type": "string", "minLength": 1 },
        "compositionIntent": {
          "enum": [
            "neutral",
            "resolve",
            "build-tension",
            "darken-emotional",
            "surprise",
            "smooth-voice-leading"
          ]
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/chordStep" },
        { "$ref": "#/$defs/restStep" }
      ]
    },
    "chordStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "harmonicFunction", "harmonicVariant", "duration", "performance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "chord" },
        "harmonicFunction": { "type": "object" },
        "harmonicVariant": { "type": "object" },
        "duration": { "$ref": "#/$defs/duration" },
        "performance": { "type": "object" },
        "cardView": { "enum": ["harmonic", "piano", "staff"] },
        "explicitSpellingOverrides": { "type": "object" },
        "melody": { "$ref": "#/$defs/melodyRecipe" }
      }
    },
    "restStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "duration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "rest" },
        "duration": { "$ref": "#/$defs/duration" }
      }
    },
    "melodyRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "grid", "octaveOffset"],
      "properties": {
        "pattern": {
          "enum": ["up", "down", "up-down", "down-up", "outside-in", "inside-out"]
        },
        "grid": {
          "enum": ["quarter", "eighth", "sixteenth", "eighth-triplet", "sixteenth-triplet"]
        },
        "octaveOffset": { "type": "integer", "minimum": -2, "maximum": 2 }
      }
    }
  }
}
