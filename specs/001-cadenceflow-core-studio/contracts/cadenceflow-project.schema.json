{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadenceflow.local/schema/project-v11.json",
  "title": "CadenceFlow Project v11",
  "$comment": "Schema v11 persists reversible Chord Properties origin snapshots, modal-borrow provenance, extended harmonic variants, semantic inversion/bass choices, and the project-wide independent bass voice setting alongside v10 Step-local semitone transposition. Authored timing is relative Rational; absolute timeline and progression-tail clipping are derived. Generated recipes remain chord-only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "createdAt",
    "updatedAt",
    "activeModule",
    "tonic",
    "globalTiming",
    "groove",
    "presentation",
    "harmonyTrack",
    "melodyTrack",
    "defaults",
    "moduleTemplateStates",
    "progression",
    "customPresets"
  ],
  "properties": {
    "schemaVersion": { "const": 11 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "activeModule": { "enum": ["progressions", "dark-harmony"] },
    "tonic": { "$ref": "#/$defs/pitchClass" },
    "globalTiming": { "$ref": "#/$defs/globalTiming" },
    "groove": { "$ref": "#/$defs/groove" },
    "harmonyTrack": { "$ref": "#/$defs/harmonyTrack" },
    "melodyTrack": { "$ref": "#/$defs/melodyTrack" },
    "independentBassEnabled": { "type": "boolean" },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expertiseMode",
        "theme",
        "globalMatrixCardView",
        "showBassInStaff",
        "noteColorMode"
      ],
      "properties": {
        "expertiseMode": { "enum": ["beginner", "composer", "expert"] },
        "theme": { "enum": ["dark", "light"] },
        "globalMatrixCardView": {
          "enum": ["harmonic", "piano", "staff", "guitar", "tablature"]
        },
        "progressionView": {
          "enum": ["harmonic", "piano", "staff", "guitar", "tablature", "piano-roll"]
        },
        "measuresPerSystem": { "enum": ["auto", 1, 2, 3, 4, 5, 6, 7, 8] },
        "measureLayoutColumns": {
          "description": "Pre-v9 alias for measuresPerSystem; decodeMeasuresPerSystem maps it when measuresPerSystem is absent. Accepted so tightened validation does not reject genuine legacy files.",
          "anyOf": [{ "enum": ["auto", "1", "2", "3", "4", "5", "6", "7", "8"] }, { "type": "integer", "minimum": 1, "maximum": 8 }]
        },
        "showBassInStaff": { "type": "boolean" },
        "noteColorMode": { "enum": ["standard", "suzuki", "harmonic-role"] },
        "guitarChordColorMode": { "enum": ["chord-roles", "fingering"] },
        "resolutionArrows": { "type": "boolean" },
        "genreFocus": { "type": "string", "minLength": 1 },
        "guitarChordOrientation": { "enum": ["vertical", "horizontal"] },
        "sidePanelMode": { "enum": ["fixed", "autohide"] }
      },
      "$comment": "Presentation-only note/guitar marker color modes and existing view preferences. `additionalProperties` is false and the optional keys above are enumerated exhaustively, so a future field added to the encoder fails loudly here instead of being written into files the validator silently tolerates. The `required` list mirrors the non-optional members of PresentationState in src/domain/project/project.ts."
    },
    "defaults": { "type": "object" },
    "moduleTemplateStates": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "progression": { "$ref": "#/$defs/progression" },
    "temporaryBranch": {
      "anyOf": [{ "$ref": "#/$defs/temporaryBranch" }, { "type": "null" }]
    },
    "customPresets": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "harmonicFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "functionId", "category"],
      "properties": {
        "moduleId": { "enum": ["progressions", "dark-harmony"] },
        "functionId": { "type": "string", "minLength": 1 },
        "category": { "enum": ["core", "secondary-dominant", "modal-interchange", "secondary-diminished", "neapolitan", "chromatic-color"] },
        "targetFunctionId": { "type": "string" },
        "targetId": { "type": "string" },
        "mixPolicy": { "enum": ["mix-freely", "must-resolve"] },
        "bassScaleDegree": { "type": "integer", "minimum": 1, "maximum": 13 },
        "borrowedFromMode": { "enum": ["ionian", "dorian", "phrygian", "lydian", "mixolydian", "aeolian", "locrian"] },
        "borrowedDegree": { "type": "integer", "minimum": 1, "maximum": 7 }
      }
    },
    "harmonicVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensions", "suspensions", "alterations"],
      "properties": {
        "baseQualityOverride": { "enum": ["major", "minor", "diminished", "augmented", "dominant"] },
        "seventh": { "enum": ["minor7", "major7", "diminished7", "half-diminished7"] },
        "extensions": { "type": "array", "uniqueItems": true, "items": { "enum": [9, 11, 13] } },
        "suspensions": { "type": "array", "uniqueItems": true, "items": { "enum": ["sus2", "sus4"] } },
        "alterations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["degree", "semitones"],
            "properties": {
              "degree": { "enum": [5, 9, 11, 13] },
              "semitones": { "enum": [-1, 1] }
            }
          }
        },
        "add9": { "type": "boolean" },
        "add11": { "type": "boolean" },
        "add13": { "type": "boolean" },
        "no3": { "type": "boolean" },
        "no5": { "type": "boolean" }
      }
    },
    "bassSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice", "octaveOffset"],
      "properties": {
        "choice": { "enum": ["auto", "root", "second", "third", "fourth", "fifth", "seventh", "ninth", "eleventh", "thirteenth", "custom"] },
        "octaveOffset": { "enum": ["auto", -1, -2] },
        "customPitch": { "$ref": "#/$defs/exactPitch" }
      }
    },
    "chordPropertiesFunctionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harmonicFunction", "harmonicVariant"],
      "properties": {
        "harmonicFunction": { "$ref": "#/$defs/harmonicFunction" },
        "harmonicVariant": { "$ref": "#/$defs/harmonicVariant" }
      }
    },
    "chordPropertiesOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["harmonicFunction", "harmonicVariant", "bass"],
          "properties": {
            "harmonicFunction": { "$ref": "#/$defs/harmonicFunction" },
            "harmonicVariant": { "$ref": "#/$defs/harmonicVariant" },
            "inversion": { "enum": ["auto", 0, 1, 2, 3, 4, 5, 6] },
            "bass": { "$ref": "#/$defs/bassSettings" }
          }
        },
        "secondaryBase": { "$ref": "#/$defs/chordPropertiesFunctionState" },
        "borrowBase": { "$ref": "#/$defs/chordPropertiesFunctionState" }
      }
    },
    "pitchClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semitone"],
      "properties": {
        "semitone": { "type": "integer", "minimum": 0, "maximum": 11 }
      }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer" },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beats"],
      "properties": {
        "beats": { "$ref": "#/$defs/rational" },
        "displayHint": { "type": "string" }
      }
    },
    "globalTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tempoBpm", "meter"],
      "properties": {
        "tempoBpm": { "type": "number", "exclusiveMinimum": 0 },
        "meter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator", "grouping"],
          "properties": {
            "numerator": { "type": "integer", "minimum": 1 },
            "denominator": { "enum": [1, 2, 4, 8, 16, 32] },
            "grouping": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "groove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feel", "swingAmount"],
      "properties": {
        "feel": { "enum": ["straight", "swing"] },
        "swingAmount": { "type": "number" }
      }
    },
    "melodyTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument", "muted", "solo", "volume"],
      "properties": {
        "instrument": { "$ref": "#/$defs/melodyInstrument" },
        "muted": { "type": "boolean" },
        "solo": { "type": "boolean" },
        "volume": { "type": "integer", "minimum": 0, "maximum": 127 }
      },
      "not": {
        "required": ["muted", "solo"],
        "properties": {
          "muted": { "const": true },
          "solo": { "const": true }
        }
      }
    },
    "harmonyTrack": {
      "type": "object",
      "$comment": "All active Piano/Guitar engine and SoundFont tone selections persist in schema v6.",
      "additionalProperties": false,
      "required": ["instrument", "muted", "solo", "volume", "pianoEngine", "guitarEngine", "pianoSoundfontInstrument", "guitarSoundfontInstrument"],
      "properties": {
        "instrument": {
          "anyOf": [
            { "const": "piano" },
            { "$ref": "#/$defs/melodyInstrument" }
          ]
        },
        "muted": { "type": "boolean" },
        "solo": { "type": "boolean" },
        "volume": { "type": "integer", "minimum": 0, "maximum": 127 },
        "pianoEngine": { "enum": ["hq-samples", "soundfont"] },
        "guitarEngine": { "enum": ["hq-samples", "soundfont"] },
        "guitarSoundfontInstrument": { "$ref": "#/$defs/melodyInstrument" },
        "pianoSoundfontInstrument": { "$ref": "#/$defs/melodyInstrument" }
      },
      "not": {
        "required": ["muted", "solo"],
        "properties": {
          "muted": { "const": true },
          "solo": { "const": true }
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "sections"],
      "properties": {
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        },
        "selectedStepId": { "type": ["string", "null"] },
        "loopRegion": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["startStepId", "endStepId"],
              "properties": {
                "startStepId": { "type": "string", "minLength": 1 },
                "endStepId": { "type": "string", "minLength": 1 }
              }
            }
          ],
          "$comment": "Both anchors are required. A region missing either one reached validateLoopRegion and threw RangeError during playback, so the schema now rejects it at the boundary."
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "startStepId"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "startStepId": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "temporaryBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originAtEnd", "steps", "compositionIntent"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "originStepId": { "type": "string", "minLength": 1 },
        "originAtEnd": { "type": "boolean" },
        "rejoinStepId": { "type": "string", "minLength": 1 },
        "compositionIntent": {
          "enum": [
            "neutral",
            "resolve",
            "build-tension",
            "darken-emotional",
            "surprise",
            "smooth-voice-leading"
          ]
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/chordStep" },
        { "$ref": "#/$defs/restStep" }
      ]
    },
    "chordStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "harmonicFunction", "harmonicVariant", "duration", "performance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "chord" },
        "transpositionSemitones": { "type": "integer", "minimum": -127, "maximum": 127 },
        "harmonicFunction": { "$ref": "#/$defs/harmonicFunction" },
        "harmonicVariant": { "$ref": "#/$defs/harmonicVariant" },
        "chordPropertiesOrigin": { "$ref": "#/$defs/chordPropertiesOrigin" },
        "duration": { "$ref": "#/$defs/duration" },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["articulation", "register", "voicingMode", "bass", "masterVelocity", "perNoteVelocityOverrides", "dynamicsViewPreference"],
          "properties": {
            "articulation": { "enum": ["block", "arp-up", "arp-down", "broken-chord", "humanized"] },
            "register": { "enum": ["auto", -2, -1, 0, 1, 2] },
            "voicingMode": { "enum": ["auto", "manual"] },
            "inversion": { "enum": ["auto", 0, 1, 2, 3, 4, 5, 6] },
            "manualVoicing": { "type": "array", "items": { "$ref": "#/$defs/exactPitch" } },
            "bass": { "$ref": "#/$defs/bassSettings" },
            "masterVelocity": { "type": "integer", "minimum": 1, "maximum": 127 },
            "perNoteVelocityOverrides": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 127 } },
            "dynamicsViewPreference": { "enum": ["musical", "midi"] }
          }
        },
        "cardView": { "enum": ["harmonic", "piano", "staff", "guitar", "tablature"] },
        "explicitSpellingOverrides": { "type": "object" },
        "melody": { "$ref": "#/$defs/chordMelody" },
        "melodyInstrumentOverride": { "$ref": "#/$defs/melodyInstrument" }
      }
    },
    "restStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "duration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "rest" },
        "transpositionSemitones": { "type": "integer", "minimum": -127, "maximum": 127 },
        "duration": { "$ref": "#/$defs/duration" },
        "authoredMelody": { "$ref": "#/$defs/authoredMelodyPhrase" },
        "melodyInstrumentOverride": { "$ref": "#/$defs/melodyInstrument" }
      }
    },
    "melodyInstrument": {
      "type": "string",
      "enum": [
        "flute",
        "violin",
        "clarinet",
        "oboe",
        "cello",
        "synth-lead",
        "gm-000",
        "gm-001",
        "gm-002",
        "gm-003",
        "gm-004",
        "gm-005",
        "gm-006",
        "gm-007",
        "gm-008",
        "gm-009",
        "gm-010",
        "gm-011",
        "gm-012",
        "gm-013",
        "gm-014",
        "gm-015",
        "gm-016",
        "gm-017",
        "gm-018",
        "gm-019",
        "gm-020",
        "gm-021",
        "gm-022",
        "gm-023",
        "gm-024",
        "gm-025",
        "gm-026",
        "gm-027",
        "gm-028",
        "gm-029",
        "gm-030",
        "gm-031",
        "gm-032",
        "gm-033",
        "gm-034",
        "gm-035",
        "gm-036",
        "gm-037",
        "gm-038",
        "gm-039",
        "gm-041",
        "gm-043",
        "gm-044",
        "gm-045",
        "gm-046",
        "gm-047",
        "gm-048",
        "gm-049",
        "gm-050",
        "gm-051",
        "gm-052",
        "gm-053",
        "gm-054",
        "gm-055",
        "gm-056",
        "gm-057",
        "gm-058",
        "gm-059",
        "gm-060",
        "gm-061",
        "gm-062",
        "gm-063",
        "gm-064",
        "gm-065",
        "gm-066",
        "gm-067",
        "gm-069",
        "gm-070",
        "gm-072",
        "gm-074",
        "gm-075",
        "gm-076",
        "gm-077",
        "gm-078",
        "gm-079",
        "gm-081",
        "gm-082",
        "gm-083",
        "gm-084",
        "gm-085",
        "gm-086",
        "gm-087",
        "gm-088",
        "gm-089",
        "gm-090",
        "gm-091",
        "gm-092",
        "gm-093",
        "gm-094",
        "gm-095",
        "gm-096",
        "gm-097",
        "gm-098",
        "gm-099",
        "gm-100",
        "gm-101",
        "gm-102",
        "gm-103",
        "gm-104",
        "gm-105",
        "gm-106",
        "gm-107",
        "gm-108",
        "gm-109",
        "gm-110",
        "gm-111",
        "gm-112",
        "gm-113",
        "gm-114",
        "gm-115",
        "gm-116",
        "gm-117",
        "gm-118",
        "gm-119",
        "gm-120",
        "gm-121",
        "gm-122",
        "gm-123",
        "gm-124",
        "gm-125",
        "gm-126",
        "gm-127"
      ]
    },
    "chordMelody": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "recipe"],
          "properties": {
            "mode": { "const": "generated" },
            "recipe": { "$ref": "#/$defs/melodyRecipe" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "phrase"],
          "properties": {
            "mode": { "const": "authored" },
            "phrase": {
              "type": "object",
              "additionalProperties": false,
              "required": ["notes"],
              "properties": { "notes": { "type": "array", "items": { "$ref": "#/$defs/authoredMelodyNote" } } }
            },
            "sourceRecipe": { "$ref": "#/$defs/melodyRecipe" }
          }
        }
      ]
    },
    "authoredMelodyPhrase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notes"],
      "properties": {
        "notes": { "type": "array", "items": { "$ref": "#/$defs/authoredMelodyNote" } },
        "sourceRecipe": { "$ref": "#/$defs/melodyRecipe" }
      }
    },
    "authoredMelodyNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pitch", "onset", "duration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pitch": { "$ref": "#/$defs/exactPitch" },
        "sourcePitchMidi": { "type": "integer", "minimum": 0, "maximum": 127 },
        "onset": { "$ref": "#/$defs/rational" },
        "duration": { "allOf": [{ "$ref": "#/$defs/rational" }], "properties": { "numerator": { "type": "integer", "minimum": 1 } } }
      }
    },
    "exactPitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["midiNumber", "pitchClassIdentity", "octave", "spelling"],
      "properties": {
        "midiNumber": { "type": "integer", "minimum": 0, "maximum": 127 },
        "pitchClassIdentity": { "type": "integer", "minimum": 0, "maximum": 11 },
        "octave": { "type": "integer" },
        "transpositionCompensationSemitones": { "type": "integer", "minimum": -127, "maximum": 127 },
        "transpositionSpellingOverride": {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "alter"],
          "properties": { "step": { "enum": ["C", "D", "E", "F", "G", "A", "B"] }, "alter": { "type": "integer" } }
        },
        "spelling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "alter"],
          "properties": { "step": { "enum": ["C", "D", "E", "F", "G", "A", "B"] }, "alter": { "type": "integer" } }
        }
      }
    },
    "melodyRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitchMotion", "rhythm", "connection", "grid", "octaveOffset"],
      "properties": {
        "pitchMotion": {
          "enum": [
            "up",
            "down",
            "up-down",
            "down-up",
            "outside-in",
            "inside-out",
            "repeat-root",
            "repeat-top",
            "alternate-root-up",
            "alternate-top-down"
          ]
        },
        "rhythm": { "enum": ["even", "dotted", "reverse-dotted", "tresillo"] },
        "connection": { "enum": ["retrigger", "tie-repeated"] },
        "grid": {
          "enum": ["quarter", "eighth", "sixteenth", "eighth-triplet", "sixteenth-triplet"]
        },
          "octaveOffset": { "type": "integer", "minimum": -2, "maximum": 2 },
          "targetNextPitchClass": { "type": "integer", "minimum": 0, "maximum": 11 }
      }
    }
  }
}
