{
  "compilerOptions": {
    "target": "ES2022",
    // Deliberately no "DOM": domain and command layers must not depend on browser globals.
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    // See tsconfig.domain.json: lets a UI/React import fail with a layering-relevant error.
    "jsx": "preserve"
  },
  "include": [
    "src/domain/**/*.ts",
    "src/instruments/contracts.ts",
    "src/audio/contracts.ts",
    "src/app/commands/**/*.ts",
    "src/app/history/**/*.ts",
    "src/app/appStore.ts"
  ]
}
